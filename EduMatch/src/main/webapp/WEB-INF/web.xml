<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
         http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>EduMatch - College Discovery Platform</display-name>

    <!-- ============================================================
         CONTEXT PARAMETERS
         ============================================================ -->
    <context-param>
        <param-name>DB_URL</param-name>
        <param-value>jdbc:mysql://localhost:3306/edumatch_db?useSSL=false&amp;serverTimezone=Asia/Kathmandu&amp;allowPublicKeyRetrieval=true</param-value>
    </context-param>
    <context-param>
        <param-name>DB_USER</param-name>
        <param-value>root</param-value>
    </context-param>
    <context-param>
        <param-name>DB_PASSWORD</param-name>
        <param-value>root</param-value>
    </context-param>
    <context-param>
        <param-name>UPLOAD_DIR</param-name>
        <param-value>/uploads</param-value>
    </context-param>

    <!-- ============================================================
         FILTERS
         ============================================================ -->
    <!-- Authentication Filter -->
    <filter>
        <filter-name>AuthenticationFilter</filter-name>
        <filter-class>com.edumatch.filter.AuthenticationFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AuthenticationFilter</filter-name>
        <url-pattern>/student/*</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AuthenticationFilter</filter-name>
        <url-pattern>/admin/*</url-pattern>
    </filter-mapping>

    <!-- Encoding Filter -->
    <filter>
        <filter-name>EncodingFilter</filter-name>
        <filter-class>com.edumatch.filter.EncodingFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>EncodingFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- ============================================================
         SERVLETS
         ============================================================ -->

    <!-- Home Servlet -->
    <servlet>
        <servlet-name>HomeServlet</servlet-name>
        <servlet-class>com.edumatch.controller.HomeServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>HomeServlet</servlet-name>
        <url-pattern>/</url-pattern>
    </servlet-mapping>

    <!-- Auth Servlets -->
    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>com.edumatch.controller.LoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>RegisterServlet</servlet-name>
        <servlet-class>com.edumatch.controller.RegisterServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RegisterServlet</servlet-name>
        <url-pattern>/register</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>com.edumatch.controller.LogoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>

    <!-- College Servlets -->
    <servlet>
        <servlet-name>CollegeServlet</servlet-name>
        <servlet-class>com.edumatch.controller.CollegeServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CollegeServlet</servlet-name>
        <url-pattern>/colleges</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>CollegeServlet</servlet-name>
        <url-pattern>/college/*</url-pattern>
    </servlet-mapping>

    <!-- Student Servlets -->
    <servlet>
        <servlet-name>StudentDashboardServlet</servlet-name>
        <servlet-class>com.edumatch.controller.StudentDashboardServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>StudentDashboardServlet</servlet-name>
        <url-pattern>/student/dashboard</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>StudentProfileServlet</servlet-name>
        <servlet-class>com.edumatch.controller.StudentProfileServlet</servlet-class>
        <multipart-config>
            <max-file-size>5242880</max-file-size>
            <max-request-size>10485760</max-request-size>
        </multipart-config>
    </servlet>
    <servlet-mapping>
        <servlet-name>StudentProfileServlet</servlet-name>
        <url-pattern>/student/profile</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AcademicRecordServlet</servlet-name>
        <servlet-class>com.edumatch.controller.AcademicRecordServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AcademicRecordServlet</servlet-name>
        <url-pattern>/student/academic</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>CollegeMatchServlet</servlet-name>
        <servlet-class>com.edumatch.controller.CollegeMatchServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CollegeMatchServlet</servlet-name>
        <url-pattern>/student/match</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ApplicationServlet</servlet-name>
        <servlet-class>com.edumatch.controller.ApplicationServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ApplicationServlet</servlet-name>
        <url-pattern>/student/applications</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>ApplicationServlet</servlet-name>
        <url-pattern>/student/application/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>SavedCollegeServlet</servlet-name>
        <servlet-class>com.edumatch.controller.SavedCollegeServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>SavedCollegeServlet</servlet-name>
        <url-pattern>/student/saved</url-pattern>
    </servlet-mapping>

    <!-- Admin Servlets -->
    <servlet>
        <servlet-name>AdminDashboardServlet</servlet-name>
        <servlet-class>com.edumatch.controller.AdminDashboardServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminDashboardServlet</servlet-name>
        <url-pattern>/admin/dashboard</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AdminCollegeServlet</servlet-name>
        <servlet-class>com.edumatch.controller.AdminCollegeServlet</servlet-class>
        <multipart-config>
            <max-file-size>10485760</max-file-size>
        </multipart-config>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminCollegeServlet</servlet-name>
        <url-pattern>/admin/colleges</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>AdminCollegeServlet</servlet-name>
        <url-pattern>/admin/college/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AdminProgramServlet</servlet-name>
        <servlet-class>com.edumatch.controller.AdminProgramServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminProgramServlet</servlet-name>
        <url-pattern>/admin/programs</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>AdminProgramServlet</servlet-name>
        <url-pattern>/admin/program/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AdminUserServlet</servlet-name>
        <servlet-class>com.edumatch.controller.AdminUserServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminUserServlet</servlet-name>
        <url-pattern>/admin/users</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>AdminUserServlet</servlet-name>
        <url-pattern>/admin/user/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AdminApplicationServlet</servlet-name>
        <servlet-class>com.edumatch.controller.AdminApplicationServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminApplicationServlet</servlet-name>
        <url-pattern>/admin/applications</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>AdminApplicationServlet</servlet-name>
        <url-pattern>/admin/application/*</url-pattern>
    </servlet-mapping>

    <!-- ============================================================
         SESSION CONFIGURATION
         ============================================================ -->
    <session-config>
        <session-timeout>30</session-timeout>
        <cookie-config>
            <http-only>true</http-only>
        </cookie-config>
    </session-config>

    <!-- ============================================================
         ERROR PAGES
         ============================================================ -->
    <error-page>
        <error-code>403</error-code>
        <location>/WEB-INF/views/error/403.jsp</location>
    </error-page>
    <error-page>
        <error-code>404</error-code>
        <location>/WEB-INF/views/error/404.jsp</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/WEB-INF/views/error/500.jsp</location>
    </error-page>
    <error-page>
        <exception-type>java.lang.Exception</exception-type>
        <location>/WEB-INF/views/error/500.jsp</location>
    </error-page>

    <!-- Welcome File -->
    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

</web-app>
